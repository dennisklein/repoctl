{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsi-hpc.github.io/repoctl/schema/v1alpha1/events.json",
  "title": "repoctl run journal line (runs/<run>.jsonl), format v1",
  "type": "object",
  "required": [
    "v",
    "run",
    "seq",
    "time",
    "type"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "run": {
      "$ref": "output.json#/$defs/RunId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Gapless per run, from 1. The one order of the run."
    },
    "time": {
      "$ref": "output.json#/$defs/Time"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "span": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "go-clikit span id this event is about (same id as in runs/<run>.progress.jsonl)."
    },
    "parent": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "node": {
      "$ref": "output.json#/$defs/NodeId"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/RunStarted"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan.ready"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/PlanReady"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "node.state"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/NodeStateEvent"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "node.step"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/NodeStepEvent"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "node.log"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/NodeLogEvent"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact.added"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/ArtifactAdded"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "staging.updated"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/StagingUpdated"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "warning"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/WarningEvent"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.cancel-requested"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/CancelRequested"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.finished"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/RunFinished"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "publish.started"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/PublishStarted"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "publish.step"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/PublishStep"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "publish.finished"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/PublishFinished"
      }
    }
  ],
  "$defs": {
    "EventType": {
      "description": "Open: a reader skips a line whose type it does not know.",
      "enum": [
        "run.started",
        "plan.ready",
        "node.state",
        "node.step",
        "node.log",
        "artifact.added",
        "staging.updated",
        "warning",
        "run.cancel-requested",
        "run.finished",
        "publish.started",
        "publish.step",
        "publish.finished"
      ]
    },
    "RunStarted": {
      "required": [
        "set",
        "kind",
        "trace",
        "origin"
      ],
      "properties": {
        "set": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "build",
            "publish"
          ]
        },
        "trace": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "traceParent": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "Span of the program that started this run (TRACEPARENT), e.g. the MCP server or the web UI."
        },
        "origin": {
          "type": "object",
          "required": [
            "via",
            "user",
            "host"
          ],
          "properties": {
            "via": {
              "$ref": "output.json#/$defs/RunOrigin"
            },
            "user": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "client": {
              "type": "string"
            }
          }
        },
        "selection": {
          "$ref": "output.json#/$defs/Selection"
        },
        "setCommit": {
          "$ref": "output.json#/$defs/Commit"
        },
        "repoctl": {
          "type": "string"
        },
        "fromRun": {
          "$ref": "output.json#/$defs/RunId"
        }
      }
    },
    "PlanReady": {
      "description": "Sets every node's first state: build nodes whose deps are all done start queued, other build nodes start waiting, cached nodes are cached. No node.state line is written for these first states.",
      "required": [
        "summary",
        "build",
        "cached"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "build",
            "cached",
            "skip"
          ],
          "properties": {
            "build": {
              "type": "integer"
            },
            "cached": {
              "type": "integer"
            },
            "skip": {
              "type": "integer"
            }
          }
        },
        "build": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node",
              "reasons"
            ],
            "properties": {
              "node": {
                "$ref": "output.json#/$defs/NodeId"
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "output.json#/$defs/PlanReasonCode"
                }
              },
              "deps": {
                "type": "array",
                "items": {
                  "$ref": "output.json#/$defs/NodeId"
                }
              }
            }
          }
        },
        "cached": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/NodeId"
          }
        },
        "skip": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/NodeId"
          }
        }
      }
    },
    "NodeStateEvent": {
      "required": [
        "node",
        "state",
        "prev"
      ],
      "properties": {
        "state": {
          "$ref": "output.json#/$defs/NodeState"
        },
        "prev": {
          "$ref": "output.json#/$defs/NodeState"
        },
        "durationMs": {
          "$ref": "output.json#/$defs/DurationMs"
        },
        "error": {
          "$ref": "output.json#/$defs/NodeError"
        },
        "blockedBy": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/NodeId"
          }
        },
        "nvrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NodeStepEvent": {
      "required": [
        "node",
        "step",
        "phase"
      ],
      "properties": {
        "step": {
          "$ref": "output.json#/$defs/Step"
        },
        "phase": {
          "enum": [
            "started",
            "ended"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "canceled"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "durationMs": {
          "$ref": "output.json#/$defs/DurationMs"
        }
      }
    },
    "NodeLogEvent": {
      "description": "Sampled: at most one per node every 2 s. The full text is in logs/<run>/<node>.log.",
      "required": [
        "node",
        "step",
        "line",
        "offset"
      ],
      "properties": {
        "step": {
          "$ref": "output.json#/$defs/Step"
        },
        "line": {
          "type": "string",
          "maxLength": 512
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte offset of this line in the node log."
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines written to the node log since the previous node.log event of this node and not sent here."
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      }
    },
    "ArtifactAdded": {
      "required": [
        "node",
        "kind",
        "repo",
        "nvra",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rpm",
            "srpm",
            "debuginfo",
            "debugsource"
          ]
        },
        "repo": {
          "type": "string"
        },
        "nvra": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer"
        },
        "sha256": {
          "$ref": "output.json#/$defs/Sha256"
        }
      }
    },
    "StagingUpdated": {
      "required": [
        "target",
        "repo",
        "packages"
      ],
      "properties": {
        "target": {
          "$ref": "output.json#/$defs/TargetId"
        },
        "repo": {
          "type": "string"
        },
        "packages": {
          "type": "integer"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "WarningEvent": {
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "output.json#/$defs/ProblemCode"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "$ref": "output.json#/$defs/TargetId"
        }
      }
    },
    "CancelRequested": {
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "$ref": "output.json#/$defs/RunOrigin"
        },
        "user": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "signal",
            "ui",
            "mcp",
            "deadline"
          ]
        }
      }
    },
    "RunFinished": {
      "required": [
        "state",
        "counts",
        "durationMs",
        "exitCode"
      ],
      "properties": {
        "state": {
          "$ref": "output.json#/$defs/RunState"
        },
        "counts": {
          "$ref": "output.json#/$defs/StateCounts"
        },
        "durationMs": {
          "$ref": "output.json#/$defs/DurationMs"
        },
        "exitCode": {
          "type": "integer"
        },
        "publishable": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/TargetId"
          }
        }
      }
    },
    "PublishStarted": {
      "required": [
        "fromRun",
        "targets",
        "by",
        "signer"
      ],
      "properties": {
        "fromRun": {
          "$ref": "output.json#/$defs/RunId"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/TargetId"
          }
        },
        "by": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "signer": {
          "$ref": "output.json#/$defs/Signer"
        }
      }
    },
    "PublishStep": {
      "required": [
        "target",
        "step",
        "phase"
      ],
      "properties": {
        "target": {
          "$ref": "output.json#/$defs/TargetId"
        },
        "repo": {
          "type": "string"
        },
        "step": {
          "enum": [
            "check",
            "sign",
            "repodata",
            "verify",
            "swap"
          ]
        },
        "phase": {
          "enum": [
            "started",
            "ended"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "canceled",
            "skipped"
          ]
        },
        "count": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "PublishFinished": {
      "required": [
        "state",
        "targets"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "failed",
            "canceled"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "output.json#/$defs/TargetId"
          }
        },
        "exitCode": {
          "type": "integer"
        }
      }
    }
  }
}
