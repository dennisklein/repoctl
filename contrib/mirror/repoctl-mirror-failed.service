# repoctl-mirror-failed.service: /usr/lib/systemd/system/ from the RPM, or
# /etc/systemd/system/ by hand.
# Runs NOTIFY failed of /etc/repoctl-mirror.conf with the last 50 journal
# lines of the job on its standard input. Without NOTIFY it does nothing.
[Unit]
Description=repoctl mirror job: notify a failure

[Service]
Type=oneshot
User=repoctl-mirror
Group=repoctl-mirror
# Read the journal of repoctl-mirror.service.
SupplementaryGroups=systemd-journal
ExecStart=/usr/libexec/repoctl-mirror/mirror --notify-failed /etc/repoctl-mirror.conf
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
