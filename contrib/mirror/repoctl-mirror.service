# /etc/systemd/system/repoctl-mirror.service
# The repoctl mirror job (docs/design/publish.html#mirror-health).
[Unit]
Description=repoctl mirror job
Wants=network-online.target
After=network-online.target
OnFailure=repoctl-mirror-failed.service

[Service]
Type=oneshot
User=repoctl-mirror
Group=repoctl-mirror
ExecStart=/usr/libexec/repoctl-mirror/mirror /etc/repoctl-mirror.conf
# STATE_DIR of the default config: .objects/ and .trees/. The HTTP server
# reads the trees through the symlink of each served path.
StateDirectory=repoctl-mirror
StateDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
