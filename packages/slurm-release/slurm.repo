[slurm]
name=GSI Slurm Packages
baseurl=http://cluster-mirror.hpc.gsi.de/packages/slurm-25.05/el$releasever/slurm
enabled=1
repo_gpgcheck=1
type=rpm-md
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-slurm
metadata_expire=3600

[slurm-debuginfo]
name=GSI Slurm Packages - Debug
baseurl=http://cluster-mirror.hpc.gsi.de/packages/slurm-25.05/el$releasever/slurm-debuginfo
enabled=0
repo_gpgcheck=1
type=rpm-md
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-slurm
metadata_expire=3600

[slurm-source]
name=GSI Slurm Packages - Source
baseurl=http://cluster-mirror.hpc.gsi.de/packages/slurm-25.05/el$releasever/slurm-source
enabled=0
repo_gpgcheck=1
type=rpm-md
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-slurm
metadata_expire=3600
